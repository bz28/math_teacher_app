{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/services/api-schema.gen.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.preenv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.0.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "katex": "^0.16.45",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^9.15.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-webview": "13.15.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
