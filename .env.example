# Database
DATABASE_URL=postgresql+asyncpg://mathapp:mathapp@localhost:5432/mathapp

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API
CLAUDE_API_KEY=sk-ant-your-key-here

# OpenAI API Key
OPENAI_API_KEY=sk-proj-1234567890

# Student homework photos (api/core/photo_store.py). Leave PHOTO_BUCKET unset
# in development to keep pages on local disk, served by the API at
# PHOTO_LOCAL_BASE_URL (set it to wherever this API listens).
PHOTO_BUCKET=
PHOTO_BUCKET_ENDPOINT=
PHOTO_BUCKET_REGION=auto
PHOTO_BUCKET_ACCESS_KEY_ID=
PHOTO_BUCKET_SECRET_ACCESS_KEY=
PHOTO_LOCAL_BASE_URL=http://localhost:8000

# Sentry
SENTRY_DSN=

# App
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:8081","http://localhost:3000"]

# Cost Alerting
DAILY_COST_LIMIT_USD=50.0

# Subscriptions
REVENUECAT_WEBHOOK_SECRET=
BYPASS_SUBSCRIPTION=true

# Shared secret for POST /v1/internal/grading/drain — the endpoint the
# scheduled grading drain knocks on (.github/workflows/grading-drain.yml).
# Must match GRADING_DRAIN_TOKEN in the repo's Actions secrets.
#
# Leave EMPTY in dev: the endpoint then returns 503 and nothing drains,
# which is the safe default. Generate one for prod with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Until this is set in production, queued AI grading never runs.
GRADING_DRAIN_TOKEN=
